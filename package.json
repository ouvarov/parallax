{
  "name": "@ouvarov/parallax",
  "version": "0.1.0",
  "description": "Scroll parallax for React in under 1 KB. Zero JS at runtime. Pure CSS animation-timeline: view().",
  "keywords": [
    "react",
    "parallax",
    "scroll",
    "animation",
    "css",
    "view-timeline",
    "animation-timeline",
    "scroll-driven"
  ],
  "license": "MIT",
  "author": "Olexandr Uvarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouvarov/parallax.git"
  },
  "homepage": "https://ouvarov.github.io/parallax/",
  "bugs": {
    "url": "https://github.com/ouvarov/parallax/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "size": "gzip -c dist/index.js | wc -c && gzip -c style.css | wc -c"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
